aration":"ErdosProblems.Erdos257.PaperCompleteR21.paper_squarefree_support_engine_ceiling","evidence_ids":["comparator_not_run_locally","comparator_replay.E257_45","extraction_not_run_locally","lean_build_not_run_locally","source_bytes_audited"],"id":"lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_squarefree_support_engine_ceiling","kind":"declaration","label":"ErdosProblems.Erdos257.PaperCompleteR21.paper_squarefree_support_engine_ceiling","locator":"lean/ErdosProblems/Erdos257/PaperCompleteR21/SquarefreeSupportEngineCeiling.lean, line 20","source_id":"lean:ErdosProblems/Erdos257/PaperCompleteR21/SquarefreeSupportEngineCeiling.lean","statement":"theorem paper_squarefree_support_engine_ceiling :\n    (squarefreeSupport = {d : ℕ | 2 ≤ d ∧ Squarefree d}) ∧\n      (∀ n : ℕ, n ≠ 0 →\n        Erdos249257.supportCoeff squarefreeSupport n\n          = 2 ^ n.primeFactors.card - 1) ∧\n      (∀ n : ℕ, 2 ≤ n → Odd (Erdos249257.supportCoeff squarefreeSupport n)) ∧\n      (∀ b : ℕ, 2 ≤ b → 2 ∣ b →\n        ¬ (∀ q : ℕ, 0 < q → ∃ N K L C : ℕ, K ≤ L ∧\n            (b ^ K ∣ ∑ r ∈ Finset.Icc 1 K,\n              Erdos249257.supportCoeff squarefreeSupport (N + r) * b ^ (K - r)) ∧\n            (∑ r ∈ Finset.Icc (K + 1) L,\n              Erdos249257.supportCoeff squarefreeSupport (N + r) * b ^ (L - r) ≤ C) ∧\n            (∃ t : ℕ, 0 < Erdos249257.supportCoeff squarefreeSupport (N + L + 1 + t)) ∧\n            q * (C + (N + L + 2)) < b ^ L)) ∧\n      (∀ b : ℕ, 2 ≤ b → 2 ∣ b →\n        ¬ (∀ q : ℕ, 0 < q → ∃ N K L C : ℕ, K ≤ L ∧\n            (∀ r ∈ Finset.Icc 1 K,\n              b ^ r ∣ Erdos249257.supportCoeff squarefreeSupport (N + r)) ∧\n            (∑ r ∈ Finset.Icc (K + 1) L,\n              Erdos249257.supportCoeff squarefreeSupport (N + r) * b ^ (L - r) ≤ C) ∧\n            (∃ t : ℕ, 0 < Erdos249257.supportCoeff squarefreeSupport (N + L + 1 + t)) ∧\n            q * (C + (N + L + 2)) < b ^ L))","status":"unverified"},"ref":"sha256:5d6514073ac52d75d011c84ff900912363a94ff7fe2e141210e6bf3c445c0cc1/nodes/lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_squarefree_support_engine_ceiling","relations":[{"derived":false,"family":"arguments","from":"sha256:5d6514073ac52d75d011c84ff900912363a94ff7fe2e141210e6bf3c445c0cc1/nodes/long.prop-squarefree","id":"sha256:5d6514073ac52d75d011c84ff900912363a94ff7fe2e141210e6bf3c445c0cc1/edges/%5B%22long.prop-squarefree%22%2C%22lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_squarefree_support_engine_ceiling%22%2C%22formalizes%22%5D","kind":"formalizes","record_ref":"sha256:5d6514073ac52d75d011c84ff900912363a94ff7fe2e141210e6bf3c445c0cc1/edges/%5B%22long.prop-squarefree%22%2C%22lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_squarefree_support_engine_ceiling%22%2C%22formalizes%22%5D","semantic_class":"formalization_correspondence","to":"sha256:5d6514073ac52d75d011c84ff900912363a94ff7fe2e141210e6bf3c445c0cc1/nodes/lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_squarefree_support_engine_ceiling"},{"derived":true,"family":"provenance","from":"sha256:5d6514073ac52d75d011c84ff900912363a94ff7fe2e141210e6bf3c445c0cc1/evidence/comparator_replay.E257_45","id":"field:13cca01fbca19ca50e4136821dd2bb36757d54b366a6b3beb5a43cf7bee80694","kind":"subject_ids","owner_ref":"sha256:5d6514073ac52d75d011c84ff900912363a94ff7fe2e141210e6bf3c445c0cc1/evidence/comparator_replay.E257_45","semantic_class":"provenance_field_reference","source_field":"subject_ids","to":"sha256:5d6514073ac52d75d011c84ff900912363a94ff7fe2e141210e6bf3c445c0cc1/nodes/lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_squarefree_support_engine_ceiling"},{"derived":true,"family":"provenance","from":"sha256:5d6514073ac52d75d011c84ff900912363a94ff7fe2e141210e6bf3c445c0cc1/nodes/lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_squarefree_support_engine_ceiling","id":"field:1deb57af5d5fc4b3dc9c37fefbcbc200f3f42ec992ab1e16e162593c8c237239","kind":"source_id","owner_ref":"sha256:5d6514073ac52d75d011c84ff900912363a94ff7fe2e141210e6bf3c445c0cc1/nodes/lean.ErdosPr