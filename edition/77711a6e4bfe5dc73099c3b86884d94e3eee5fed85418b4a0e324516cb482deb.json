cite.exp.step.explicit_choices"],"evidence_ids":[],"id":"exp.step.explicit_choices","kind":"claim","label":"Explicit cutoffs chosen in the order t, Q, T, M","locator":"Section 7.2, p. 11","source_id":"paper.expository.pdf","statement":"Choose $t\\in A$ with $\\sum_{n\\in A,\\,n>t}1/n<1/(2q)$; a positive common multiple $Q$ of the selected $n\\le t$; $T\\in A$ with $2Q\\sum_{n\\in A,\\,n>T}1/n<1/(2q)$; and $M$ a positive common multiple of the cycle lengths $n/\\gcd(n,Q)$ for $t<n\\le T$. Then $\\frac1M\\sum_{m=1}^{M}R(mQ)<0+\\frac1{2q}+\\frac1{2q}=\\frac1q$.","status":"unverified"},"ref":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/nodes/exp.step.explicit_choices","relations":[{"derived":false,"family":"arguments","from":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/nodes/exp.step.explicit_choices","id":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/edges/%5B%22exp.step.explicit_choices%22%2C%22exp.step.average%22%2C%22supports%22%5D","kind":"supports","record_ref":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/edges/%5B%22exp.step.explicit_choices%22%2C%22exp.step.average%22%2C%22supports%22%5D","semantic_class":"curated_argument_support","to":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/nodes/exp.step.average"},{"derived":false,"family":"arguments","from":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/nodes/exp.step.explicit_choices","id":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/edges/%5B%22exp.step.explicit_choices%22%2C%22exp.step.cycle_bound%22%2C%22supports%22%5D","kind":"supports","record_ref":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/edges/%5B%22exp.step.explicit_choices%22%2C%22exp.step.cycle_bound%22%2C%22supports%22%5D","semantic_class":"curated_argument_support","to":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18