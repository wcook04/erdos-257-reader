 * 7 + 2)))","status":"unverified"},"ref":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/nodes/lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_two_thirds_band","relations":[{"derived":false,"family":"arguments","from":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/nodes/long.thm-two-thirds-band","id":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/edges/%5B%22long.thm-two-thirds-band%22%2C%22lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_two_thirds_band%22%2C%22formalizes%22%5D","kind":"formalizes","record_ref":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/edges/%5B%22long.thm-two-thirds-band%22%2C%22lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_two_thirds_band%22%2C%22formalizes%22%5D","semantic_class":"formalization_correspondence","to":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/nodes/lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_two_thirds_band"},{"derived":true,"family":"provenance","from":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/edges/%5B%22long.thm-two-thirds-band%22%2C%22lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_two_thirds_band%22%2C%22formalizes%22%5D","id":"field:2148c7799d9761ca4af5fa77889a25b6c124e6399ba7fa63e7d8e03ed60089d7","kind":"to","owner_ref":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/edges/%5B%22long.thm-two-thirds-band%22%2C%22lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_two_thirds_band%22%2C%22formalizes%22%5D","semantic_class":"edge_endpoint_reference","source_field":"to","to":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/nodes/lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_two_thirds_band"},{"derived":true,"family":"provenance","from":"sha256:264b08973a5f23b2f98ad989b0c1708096513d86929f19048623a2a9fe18092c/evidence/mapping.long.thm-two-thirds-band","id":"field:3361bac7e361b27df1a719c9f9c8a