sProblems.Erdos257.PaperCompleteR21.reverse_carry_word_common_bound_sharp","evidence_ids":["comparator_not_run_locally","comparator_replay.E257_25","extraction_not_run_locally","lean_build_not_run_locally","source_bytes_audited"],"id":"lean.ErdosProblems.Erdos257.PaperCompleteR21.reverse_carry_word_common_bound_sharp","kind":"declaration","label":"ErdosProblems.Erdos257.PaperCompleteR21.reverse_carry_word_common_bound_sharp","locator":"lean/ErdosProblems/Erdos257/PaperCompleteR21/SeamRowGapAndCarry.lean, line 209","source_id":"lean:ErdosProblems/Erdos257/PaperCompleteR21/SeamRowGapAndCarry.lean","statement":"theorem reverse_carry_word_common_bound_sharp :\n    ∃ (a₁ b₁ u₁ a₂ b₂ u₂ : ℕ → ℤ) (k L : ℕ) (B : ℝ),\n      (∀ m : ℕ, b₁ m + 2 * u₁ m = a₁ m + u₁ (m + 1)) ∧\n      (∀ m : ℕ, b₂ m + 2 * u₂ m = a₂ m + u₂ (m + 1)) ∧\n      a₁ k = a₂ k ∧ b₁ k - b₂ k = 1 ∧\n      (∀ j : ℕ, j < L → a₁ (k + 1 + j) = a₂ (k + 1 + j)) ∧\n      (∀ j : ℕ, j < L → b₁ (k + 1 + j) = b₂ (k + 1 + j)) ∧\n      |((u₁ (k + L + 1) : ℤ) : ℝ)| ≤ B ∧ |((u₂ (k + L + 1) : ℤ) : ℝ)| ≤ B ∧\n      ¬ ((2 : ℝ) ^ L ≤ B)","status":"unverified"},"ref":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/nodes/lean.ErdosProblems.Erdos257.PaperCompleteR21.reverse_carry_word_common_bound_sharp","relations":[{"derived":false,"family":"arguments","from":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/nodes/long.lem-reverse-carry-word","id":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/edges/%5B%22long.lem-reverse-carry-word%22%2C%22lean.ErdosProblems.Erdos257.PaperCompleteR21.reverse_carry_word_common_bound_sharp%22%2C%22formalizes%22%5D","kind":"formalizes","record_ref":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/edges/%5B%22long.lem-reverse-carry-word%22%2C%22lean.ErdosProblems.Erdos257.PaperCompleteR21.reverse_carry_word_common_bound_sharp%22%2C%22formalizes%22%5D","semantic_class":"formalization_correspondence","t