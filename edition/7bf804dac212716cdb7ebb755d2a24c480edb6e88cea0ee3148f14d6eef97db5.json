 * 7 + 2)))","status":"unverified"},"ref":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/nodes/lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_two_thirds_band","relations":[{"derived":false,"family":"arguments","from":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/nodes/long.thm-two-thirds-band","id":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/edges/%5B%22long.thm-two-thirds-band%22%2C%22lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_two_thirds_band%22%2C%22formalizes%22%5D","kind":"formalizes","record_ref":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/edges/%5B%22long.thm-two-thirds-band%22%2C%22lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_two_thirds_band%22%2C%22formalizes%22%5D","semantic_class":"formalization_correspondence","to":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/nodes/lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_two_thirds_band"},{"derived":true,"family":"provenance","from":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/nodes/lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_two_thirds_band","id":"field:11d8328743f80129048712a5edb5752f468f2a4c608228ce46e496493c02c449","kind":"evidence_ids","owner_ref":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/nodes/lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_two_thirds_band","semantic_class":"provenance_field_reference","source_field":"evidence_ids","to":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/evidence/comparator_replay.E257_25"},{"derived":true,"family":"provenance","from":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/edges/%5B%22long.thm-two-thirds-band%22%2C%22lean.ErdosProblems.Erdos257.PaperCompleteR21.paper_two_thirds_band%22%2C%22formalizes%22%5D","id":"field:194b49589ca92a644fad18e8acb779021cac789e45a817bea8a30af019117e80","kind":"to"