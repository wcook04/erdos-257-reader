s":[],"id":"step.subadditivity","kind":"claim","label":"Subadditivity links the tails U_j and V_j","locator":"Proof of Theorem 3.1","source_id":"paper.short.pdf","statement":"With $B_j=2^{\\alpha_j}$, $U_j(N)=\\sum_{r\\ge1}2^{-r}f_{F_j}(N+r)$ and $V_j(N)=\\sum_{d\\ge1}c_{j,d}w_{B_j,d}(N)$: $U_j(N)^{\\alpha_j}\\le\\sum_{r\\ge1}B_j^{-r}f_{F_j}(N+r)^{\\alpha_j}\\le\\sum_{d\\ge1}c_{j,d}\\sum_{r\\ge1,\\,d\\mid N+r}B_j^{-r}=V_j(N)$.","status":"unverified"},"ref":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/nodes/step.subadditivity","relations":[{"derived":false,"family":"arguments","from":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/nodes/step.common_distribution","id":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/edges/%5B%22step.common_distribution%22%2C%22step.subadditivity%22%2C%22supports%22%5D","kind":"supports","record_ref":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/edges/%5B%22step.common_distribution%22%2C%22step.subadditivity%22%2C%22supports%22%5D","semantic_class":"curated_argument_support","to":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/nodes/step.subadditivity"},{"derived":false,"family":"arguments","from":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/nodes/step.cover_allocation","id":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/edges/%5B%22step.cover_allocation%22%2C%22step.subadditivity%22%2C%22supports%22%5D","kind":"supports","record_ref":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/edges/%5B%22step.cover_allocation%22%2C%22step.subadditivity%22%2C%22supports%22%5D","semantic_class":"curated_argument_support","to":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/nodes/step.subadditivity"},{"derived":false,"family":"arguments","from":"sha256:72b1b4c2b4a3766719310d7deb808e62432d8c1d3e4854b25b1285cbe6056696/node